# Copia este archivo como .env y coloca los valores reales en el servidor.
# El archivo .env NO debe subirse al control de versiones.
DB_INSTANCE=SERVIDOR\SQLEXPRESS
DB_NAME=CitasMedicas
DB_USER=citasadmin
DB_PASSWORD=
DB_PORT=1433

# Dias que se conservan los archivos storage/logs/app-YYYY-MM-DD.log
LOG_RETENTION_DAYS=30