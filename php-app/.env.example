# Copia este archivo como .env y coloca los valores reales en el servidor.
# El archivo .env NO debe subirse al control de versiones.
#
# IMPORTANTE - Produccion en Linux (SQL Server 2022 Express):
# En Linux NO existen instancias con nombre (no uses SERVIDOR\SQLEXPRESS).
# La instancia es unicamente "localhost" y el puerto por defecto es 1433.
DB_INSTANCE=localhost
DB_NAME=CitasMedicas
DB_USER=citasadmin
DB_PASSWORD=
DB_PORT=1433

# Dias que se conservan los archivos storage/logs/app-YYYY-MM-DD.log
LOG_RETENTION_DAYS=30
# Clave usada para cifrar la contrasena SMTP guardada en la base de datos.
# Genera un valor aleatorio largo, por ejemplo: openssl rand -hex 32
APP_KEY=
